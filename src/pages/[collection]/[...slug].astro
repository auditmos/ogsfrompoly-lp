---
import type { CollectionKey } from "astro:content";
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { bucketUsdToNearest, formatBucketedUsd } from "@/lib/statement-format/bucketed-usd";
import { type Category, formatCategoryList } from "@/lib/statement-format/categories";
import { formatContributionPercent } from "@/lib/statement-format/contribution-percent";
import { formatPercent } from "@/lib/statement-format/percent";
import { formatPeriodLabel } from "@/lib/statement-format/period";
import {
	type MonthlyPnl,
	monthlyPnlRows,
	type PnlTone,
} from "@/lib/statement-format/monthly-pnl";
import { formatSignedUsd } from "@/lib/statement-format/signed-usd";

const PNL_BUCKET_USD = 25;

const TONE_CLASS: Record<PnlTone, string> = {
	default: "text-ink-8",
	accent: "text-accent",
	loss: "text-loss",
};

type StatementType = "weekly" | "monthly";

interface TruncatedWallet {
	truncated_id: string;
	category: Category;
	hypothetical_pnl_usd?: number;
}

interface StatementShape {
	title: string;
	summary: string;
	type: StatementType;
	period_start: string;
	period_end: string;
	hit_rate: number;
	alert_count: number;
	hypothetical_pnl_usd: number;
	categories: ReadonlyArray<Category>;
	top_wallets: ReadonlyArray<TruncatedWallet>;
	pnl?: MonthlyPnl;
	draft?: boolean;
}

function isRecord(value: unknown): value is Record<string, unknown> {
	return typeof value === "object" && value !== null;
}

function isTruncatedWallet(value: unknown): value is TruncatedWallet {
	if (!isRecord(value)) return false;
	if (typeof value.truncated_id !== "string" || value.truncated_id.length === 0) return false;
	if (typeof value.category !== "string") return false;
	if (value.hypothetical_pnl_usd !== undefined && typeof value.hypothetical_pnl_usd !== "number") {
		return false;
	}
	return true;
}

function isMonthlyPnl(value: unknown): value is MonthlyPnl {
	if (!isRecord(value)) return false;
	if (typeof value.revenue_usd !== "number") return false;
	if (typeof value.opex_usd !== "number") return false;
	if (typeof value.net_usd !== "number") return false;
	if (value.runway_months !== null && typeof value.runway_months !== "number") return false;
	return true;
}

function isStatementData(value: unknown): value is StatementShape {
	if (!isRecord(value)) return false;
	const { type, title, summary, period_start, period_end } = value;
	if (typeof title !== "string" || title.length === 0) return false;
	if (typeof summary !== "string") return false;
	if (typeof period_start !== "string" || typeof period_end !== "string") return false;
	if (type !== "weekly" && type !== "monthly") return false;
	if (typeof value.hit_rate !== "number") return false;
	if (typeof value.alert_count !== "number") return false;
	if (typeof value.hypothetical_pnl_usd !== "number") return false;
	if (!Array.isArray(value.categories)) return false;
	if (!Array.isArray(value.top_wallets)) return false;
	if (!value.top_wallets.every(isTruncatedWallet)) return false;
	if (type === "monthly" && !isMonthlyPnl(value.pnl)) return false;
	return true;
}

const { collection, slug } = Astro.params;

if (!collection || !slug) {
	return new Response("Not Found", { status: 404 });
}

let entry: Awaited<ReturnType<typeof getEntry>> | undefined;
try {
	entry = await getEntry(collection as CollectionKey, slug);
} catch {
	entry = undefined;
}

if (!entry) {
	return new Response("Not Found", { status: 404 });
}

const rawData: unknown = entry.data;
if (isRecord(rawData) && rawData.draft === true) {
	return new Response("Not Found", { status: 404 });
}

const { Content } = await render(entry);

const statement = isStatementData(rawData) ? rawData : null;
const fallbackTitle =
	isRecord(rawData) && typeof rawData.title === "string" ? rawData.title : entry.id;
const title = statement?.title ?? fallbackTitle;
const summary =
	statement?.summary ??
	(isRecord(rawData) && typeof rawData.summary === "string" ? rawData.summary : null);
const eyebrow = statement
	? `${statement.type} · ${formatPeriodLabel(statement.period_start, statement.period_end, statement.type)}`
	: null;
const pnlClass =
	statement && statement.hypothetical_pnl_usd < 0 ? "text-loss" : "text-accent";
---

<Layout title={`${title} · ogsfrompoly`} description={summary ?? undefined}>
	<main class="mx-auto max-w-5xl px-gutter py-16 sm:py-24">
		<article class="long-form-article">
			{
				eyebrow && (
					<p class="mb-6 font-mono text-eyebrow uppercase tracking-wider text-ink-6">
						{eyebrow}
					</p>
				)
			}
			<h1>{title}</h1>
			{summary && <p>{summary}</p>}
			{
				statement && (
					<dl class="not-prose mt-2 mb-10 grid grid-cols-2 gap-6 border-y border-ink-3 py-6 font-mono text-sm sm:grid-cols-4">
						<div class="flex flex-col gap-1.5">
							<dt class="text-eyebrow uppercase tracking-wider text-ink-5">Hit rate</dt>
							<dd class="text-lg text-ink-8">{formatPercent(statement.hit_rate)}</dd>
							<p class="font-sans text-xs leading-snug text-ink-5">
								Share of resolved alerts that hit the predicted side.
								{" "}0.50 ≈ a coin flip; above 0.50 is signal.
							</p>
						</div>
						<div class="flex flex-col gap-1.5">
							<dt class="text-eyebrow uppercase tracking-wider text-ink-5">Alerts</dt>
							<dd class="text-lg text-ink-8">{statement.alert_count}</dd>
							<p class="font-sans text-xs leading-snug text-ink-5">
								Retrospective signals emitted in this window from skilled
								wallets. No live alerts are published.
							</p>
						</div>
						<div class="flex flex-col gap-1.5">
							<dt class="text-eyebrow uppercase tracking-wider text-ink-5">Hypo. PnL</dt>
							<dd class={`text-lg ${pnlClass}`}>
								{formatSignedUsd(statement.hypothetical_pnl_usd)}
							</dd>
							<p class="font-sans text-xs leading-snug text-ink-5">
								Hypothetical profit/loss if every alert had been mirrored
								with a fixed bankroll. Not a real trading account.
							</p>
						</div>
						<div class="flex flex-col gap-1.5">
							<dt class="text-eyebrow uppercase tracking-wider text-ink-5">Categories</dt>
							<dd class="text-lg text-ink-8">{formatCategoryList(statement.categories)}</dd>
							<p class="font-sans text-xs leading-snug text-ink-5">
								Polymarket areas the alerts in this window cover.
							</p>
						</div>
					</dl>
				)
			}
			{
				statement && statement.type === "monthly" && statement.pnl && (
					<section class="not-prose mb-10">
						<h3 class="mb-2 font-mono text-eyebrow uppercase tracking-wider text-ink-5">
							Monthly P&amp;L
						</h3>
						<p class="mb-4 font-sans text-xs leading-snug text-ink-5">
							Open-book project economics for this month — revenue,
							operating spend, net, and how many months of runway the
							current bankroll covers. "Covered" means revenue meets or
							exceeds opex, so runway is indefinite.
						</p>
						<dl class="grid grid-cols-2 gap-6 border-y border-ink-3 py-6 font-mono text-sm sm:grid-cols-4">
							{monthlyPnlRows(statement.pnl).map((row) => (
								<div class="flex flex-col gap-1.5">
									<dt class="text-eyebrow uppercase tracking-wider text-ink-5">
										{row.label}
									</dt>
									<dd class={`text-lg tabular-nums ${TONE_CLASS[row.tone]}`}>
										{row.value}
									</dd>
								</div>
							))}
						</dl>
					</section>
				)
			}
			{
				statement && statement.top_wallets.length > 0 && (
					<section class="not-prose mb-10">
						<h3 class="mb-2 font-mono text-eyebrow uppercase tracking-wider text-ink-5">
							Top wallets ({statement.top_wallets.length})
						</h3>
						<p class="mb-4 font-sans text-xs leading-snug text-ink-5">
							Top wallets are selected by realized PnL magnitude.
							{" "}Bucket shows that wallet's approximate hypothetical PnL
							contribution, rounded to the nearest ${PNL_BUCKET_USD} to avoid
							leaking precise per-wallet sizing — rows do not sum to headline
							PnL. Share is that bucket as a fraction of headline PnL; it can
							exceed 100% when a single wallet carried the window while other
							alerts netted negative. Truncated, opaque IDs, never reversible
							to a full on-chain address. See <a class="text-ink-7 underline-offset-4 hover:text-accent hover:underline" href="/methodology">the methodology</a> for why.
						</p>
						<ul class="flex flex-col font-mono text-sm">
							<li class="grid grid-cols-[1fr_5rem_4rem_8rem] items-center gap-x-6 border-b border-ink-3 pb-2 text-eyebrow uppercase tracking-wider text-ink-5">
								<span>Wallet</span>
								<span class="text-right">Bucket</span>
								<span class="text-right">Share</span>
								<span class="text-left">Category</span>
							</li>
							{statement.top_wallets.map((wallet) => {
								const hasPnl = wallet.hypothetical_pnl_usd !== undefined;
								const bucketed = hasPnl
									? bucketUsdToNearest(
											wallet.hypothetical_pnl_usd as number,
											PNL_BUCKET_USD,
										)
									: null;
								const pnlColor =
									bucketed === null || bucketed === 0
										? "text-ink-5"
										: bucketed < 0
											? "text-loss"
											: "text-accent";
								const pctText =
									bucketed !== null
										? formatContributionPercent(
												bucketed,
												statement.hypothetical_pnl_usd,
											)
										: null;
								return (
									<li class="grid grid-cols-[1fr_5rem_4rem_8rem] items-center gap-x-6 border-b border-ink-3 py-3">
										<span class="truncate text-accent">{wallet.truncated_id}</span>
										<span class={`text-right tabular-nums ${pnlColor}`}>
											{hasPnl
												? formatBucketedUsd(
														wallet.hypothetical_pnl_usd as number,
														PNL_BUCKET_USD,
													)
												: "—"}
										</span>
										<span class={`text-right tabular-nums ${pnlColor}`}>
											{pctText ?? "—"}
										</span>
										<span class="text-left text-eyebrow uppercase tracking-wider text-ink-5">
											{wallet.category}
										</span>
									</li>
								);
							})}
						</ul>
					</section>
				)
			}
			<Content />
		</article>
	</main>
</Layout>
