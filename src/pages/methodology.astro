---
import { marked } from "marked";
import Layout from "@/layouts/Layout.astro";
import {
	methodologyDescription,
	methodologyMarkdown,
	methodologyTitle,
} from "@/methodology/content";

const html = marked.parse(methodologyMarkdown, { async: false }) as string;
---

<Layout title={`${methodologyTitle} · ogsfrompoly`} description={methodologyDescription}>
	<main class="mx-auto max-w-5xl px-gutter py-16 sm:py-24">
		<article class="methodology-article">
			<Fragment set:html={html} />
		</article>
	</main>
</Layout>
