---
import { getCollection } from "astro:content";
import DisplayHeading from "@/components/brand/DisplayHeading.astro";
import InstallSnippet from "@/components/brand/InstallSnippet.astro";
import StatementCard from "@/components/brand/StatementCard.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE_URL } from "@/lib/site/config";
import { pickLatestStatement } from "@/lib/statement-format/latest";
import { excludeDrafts } from "@/lib/statement-format/published";

const statements = excludeDrafts(await getCollection("statements"));
const latest = pickLatestStatement(statements);
---

<Layout
	title="ogsfrompoly — skilled traders on Polymarket"
	description="We measure who is actually skilled on Polymarket — and we show our work, weekly."
	localePath=""
>
	<main class="mx-auto flex max-w-4xl flex-col gap-24 px-gutter py-24">
		<section class="flex flex-col gap-8">
			<DisplayHeading eyebrow="ogsfrompoly">
				We measure who is actually skilled on Polymarket — and we show our work,
				weekly.
			</DisplayHeading>
			<p class="max-w-prose text-lg text-ink-6 [text-wrap:pretty]">
				Open-book strategy track record and project P&amp;L. Aggregate-only.
				Truncated wallet IDs. No live alpha, no signup, no newsletter — just RSS
				and a markdown feed your agent can read.
			</p>
		</section>

		<section class="flex flex-col gap-4">
			<p class="font-mono text-eyebrow uppercase text-ink-5">
				Install for your LLM agent
			</p>
			<InstallSnippet
				siteUrl={SITE_URL}
				caption="Pipes the project's llms.txt into your agent's context"
			/>
		</section>

		<section class="flex flex-col gap-4">
			<p class="font-mono text-eyebrow uppercase text-ink-5">Latest statement</p>
			{
				latest ? (
					<>
						<StatementCard
							slug={latest.id}
							type={latest.data.type}
							title={latest.data.title}
							summary={latest.data.summary}
							periodStart={latest.data.period_start}
							periodEnd={latest.data.period_end}
							hitRate={latest.data.hit_rate}
							resolvedCount={latest.data.resolved_count}
							alertCount={latest.data.alert_count}
							hypotheticalPnlUsd={latest.data.hypothetical_pnl_usd}
							categories={latest.data.categories}
						/>
						<a
							class="font-mono text-eyebrow uppercase tracking-wider text-ink-6 hover:text-accent"
							href="/statements"
						>
							View all statements →
						</a>
					</>
				) : (
					<div class="flex flex-col gap-3 rounded-card border border-dashed border-ink-3 bg-ink-1 p-6">
						<p class="text-base text-ink-7">
							No published statements yet — the first real weekly statement is
							being prepared. The cadence promise is weekly + monthly.
						</p>
						<p class="font-mono text-eyebrow uppercase text-ink-5">
							Browse <a class="text-ink-7 hover:text-accent" href="/statements">all statements</a>
							{" · "}
							subscribe via <a class="text-ink-7 hover:text-accent" href="/rss.xml">RSS</a>
							{" · "}
							<a class="text-ink-7 hover:text-accent" href="/llms.txt">llms.txt</a>
							{" · "}
							<a class="text-ink-7 hover:text-accent" href="/methodology">read the methodology</a>
						</p>
					</div>
				)
			}
		</section>

		<section class="flex flex-col gap-4">
			<p class="font-mono text-eyebrow uppercase text-ink-5">Skin in the game</p>
			<p class="max-w-prose text-base text-ink-6 [text-wrap:pretty]">
				Two small bots trade real money alongside the record — one follows a
				crowd of skilled wallets, one mirrors two hand-picked traders. Every
				rule and every live setting, explained in plain English with a
				simulator you can drag.
			</p>
			<a
				class="font-mono text-eyebrow uppercase tracking-wider text-ink-6 hover:text-accent"
				href="/for-dummies"
			>
				Copy trading for dummies →
			</a>
		</section>
	</main>
</Layout>
