---
/**
 * The semi-interactive panel on the copy-cluster walkthrough: drag the
 * executor's knobs, pick an incoming signal, watch the buy/skip decision
 * change.
 *
 * The initial paint is server-rendered from the same `evaluateSignal` the client
 * script calls, so the page is fully readable without JavaScript — it just shows
 * the live config against the first example signal. The gate list is a fixed set
 * of rows in a fixed order, so the script only rewrites text and toggles classes;
 * there is no second markup renderer to drift out of sync with this template.
 *
 * Localization (issue #73): every string resolves through the Translation
 * Catalog server-side, and the resolved simulator bundle is embedded as a JSON
 * island so the client recompute rewrites text in the same language without
 * shipping the catalog (or its overlays) to the browser.
 */
import { clusterSimFor } from "@/copy-trade/cluster/content";
import {
	CONFIG_AS_OF,
	CONFIG_MARKET,
	formatKnobValue,
	KNOB_GROUP_ORDER,
	knobsInGroup,
	LIVE_CONFIG,
	SCENARIOS,
} from "@/copy-trade/cluster/config";
import { evaluateSignal, signalLine, summarySentence } from "@/copy-trade/cluster/simulator";
import { fillTemplate, formattersFor } from "@/copy-trade/locale-format";
import { type Locale, resolveClusterPage } from "@/i18n/catalog";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const page = resolveClusterPage(locale);
const sim = clusterSimFor(locale);
const fmt = formattersFor(locale, sim.units);

const initialScenario = SCENARIOS[0];
const initial = evaluateSignal(LIVE_CONFIG, initialScenario, sim);
const initialLine = signalLine(initialScenario, sim);

/* Read off the verdict rather than imported: `simulator.ts` keeps its result
   shapes private on purpose, and a `Record` keyed on this stays exhaustive. */
type GateStage = (typeof initial.gates)[number]["stage"];

const GATE_STAGE_ORDER = ["alert", "executor"] as const satisfies readonly GateStage[];

const GATE_STAGE_LABELS: Record<GateStage, string> = {
	alert: page.ui.stageAlert,
	executor: page.ui.stageExecutor,
};

/* What a ✗ on this row actually means. An upstream ✗ is not a refusal: the alert
   is never raised, so there is no decision, no skip card and no log line. */
const GATE_STAGE_FLAGS: Record<GateStage, string> = {
	alert: page.ui.flagAlert,
	executor: page.ui.flagExecutor,
};

// `</script>`-safe: the payload is parsed by the client script, never executed.
const simPayload = JSON.stringify(sim).replace(/</g, "\\u003c");
---

<section
	class="@container not-prose my-12 overflow-hidden rounded-terminal border border-terminal-border bg-terminal-bg"
	data-copy-trade-sim
	aria-label={page.ui.ariaLabel}
>
	<script type="application/json" data-sim-locale set:html={simPayload} />
	<header
		class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-terminal-border px-5 py-4"
	>
		<h2 class="font-mono text-eyebrow uppercase tracking-wider text-ink-7">
			{page.ui.tryIt}
		</h2>
		<p class="font-mono text-[0.7rem] text-ink-5">
			{fillTemplate(page.ui.defaultsNote, { market: CONFIG_MARKET, asOf: CONFIG_AS_OF })}
		</p>
	</header>

	<!-- Container query, not a viewport breakpoint: the panel sits in a wider
	     column than the surrounding prose, so it should split on its own width. -->
	<div class="grid gap-px bg-terminal-border @3xl:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
		<div class="flex flex-col gap-6 bg-terminal-bg p-5">
			{
				KNOB_GROUP_ORDER.map((group) => (
					<fieldset class="flex flex-col gap-4 border-0 p-0">
						<legend class="font-mono text-eyebrow uppercase tracking-wider text-ink-5">
							{page.knobGroups[group]}
						</legend>
						{knobsInGroup(group).map((knob) => (
							<label class="flex flex-col gap-1">
								<span class="flex items-baseline justify-between gap-3">
									<span class="font-sans text-sm leading-snug text-ink-7">
										{page.knobs[knob.key] ?? knob.label}
									</span>
									<output
										data-knob-value={knob.key}
										class="shrink-0 font-mono text-sm tabular-nums text-accent"
									>
										{formatKnobValue(knob.unit, LIVE_CONFIG[knob.key], fmt)}
									</output>
								</span>
								<input
									type="range"
									data-knob={knob.key}
									min={knob.min}
									max={knob.max}
									step={knob.step}
									value={LIVE_CONFIG[knob.key]}
									aria-label={page.knobs[knob.key] ?? knob.label}
									class="w-full accent-accent"
								/>
								<span class="font-mono text-[0.7rem] text-ink-5">{knob.key}</span>
							</label>
						))}
					</fieldset>
				))
			}
			<button
				type="button"
				data-reset
				class="self-start rounded-card border border-ink-3 px-3 py-1.5 font-mono text-[0.7rem] uppercase tracking-wider text-ink-5 hover:border-accent-dim hover:text-accent"
			>
				{page.ui.reset}
			</button>
		</div>

		<!-- Nested container: the gate rows go inline-or-stacked on THIS column's
		     width, which is roughly half the panel once the split kicks in. -->
		<div class="@container flex flex-col gap-4 bg-terminal-bg p-5">
			<div class="flex flex-col gap-2">
				<p class="font-mono text-eyebrow uppercase tracking-wider text-ink-5">
					{page.ui.incomingSignal}
				</p>
				<div class="flex flex-wrap gap-1.5">
					{
						SCENARIOS.map((scenario) => (
							<button
								type="button"
								data-scenario={scenario.id}
								aria-pressed={scenario.id === initialScenario.id ? "true" : "false"}
								class="rounded-card border border-ink-3 px-2.5 py-1 font-mono text-[0.7rem] uppercase tracking-wider text-ink-5 hover:border-ink-4 hover:text-ink-7 aria-pressed:border-accent-dim aria-pressed:text-accent"
							>
								{page.scenarios[scenario.id] ?? scenario.label}
							</button>
						))
					}
				</div>
			</div>

			<p class="font-sans text-sm leading-snug text-ink-7">
				<span data-signal-lead>{initialLine.lead}</span>
				{" "}
				<span class="text-ink-8" data-signal-market>&ldquo;{initialLine.market}&rdquo;</span>
				{" "}
				<span data-signal-trail>{initialLine.trail}</span>
			</p>

			{
				/* Two lists, not one, because the first check is enforced somewhere else
				   entirely: below `cluster_threshold` the tracker emits no alert, so the
				   executor is never handed anything to refuse. Rendering it as rail #1
				   advertised a skip card that is never sent. */
				GATE_STAGE_ORDER.map((stage) => (
					<div class="flex flex-col gap-1.5">
						<p class="font-mono text-eyebrow uppercase tracking-wider text-ink-5">
							{GATE_STAGE_LABELS[stage]}
						</p>
						<ul class="flex flex-col font-mono text-sm">
							{initial.gates
								.filter((gate) => gate.stage === stage)
								.map((gate) => (
									<li
										data-gate={gate.id}
										class="grid grid-cols-[1rem_minmax(0,1fr)_auto] items-baseline gap-x-3 gap-y-1 border-b border-ink-3 py-2.5 last:border-b-0 @md:grid-cols-[1rem_minmax(0,1fr)_auto_auto]"
									>
										<span data-gate-mark class:list={[gate.passed ? "text-accent" : "text-loss"]}>
											{gate.passed ? "✓" : "✗"}
										</span>
										<span class="col-span-2 font-sans text-ink-7 @md:col-span-1">
											{gate.question}
										</span>
										<span
											data-gate-actual
											class="col-start-2 justify-self-end tabular-nums text-ink-8 @md:col-start-3"
										>
											{gate.actual}
										</span>
										<span
											data-gate-rule
											class="col-start-3 justify-self-end tabular-nums text-ink-5 @md:col-start-4"
										>
											{gate.rule}
										</span>
										{/* Static per row rather than rewritten by the script: a check's
										    stage never changes, so only its visibility has to. */}
										<span
											data-gate-flag
											class:list={[
												// col-start/col-end longhands, not col-span: `col-span-*` compiles to
												// the `grid-column` shorthand, which would reset the start back to auto.
												"col-start-2 col-end-4 font-sans text-xs text-loss @md:col-end-5",
												!gate.blocker && "hidden",
											]}
										>
											{GATE_STAGE_FLAGS[gate.stage]}
										</span>
									</li>
								))}
						</ul>
					</div>
				))
			}

			{/* Three states, not two. `no-signal` is deliberately the quietest of the
			    three — nothing happened, and warn-coloured chrome would dress the
			    absence of a decision up as a refusal. */}
			<div
				data-verdict
				data-action={initial.action}
				class="group flex flex-col gap-1.5 rounded-card border border-warn/40 bg-warn/5 px-4 py-3 data-[action=buy]:border-accent/40 data-[action=buy]:bg-accent/5 data-[action=no-signal]:border-ink-3 data-[action=no-signal]:bg-transparent"
			>
				<p
					data-verdict-headline
					class="font-mono text-sm font-semibold uppercase tracking-wider text-warn group-data-[action=buy]:text-accent group-data-[action=no-signal]:text-ink-5"
				>
					{initial.headline}
				</p>
				<p data-verdict-detail class="font-sans text-sm leading-snug text-ink-6">
					{initial.detail}
				</p>
			</div>

			<p class="font-sans text-xs leading-snug text-ink-5">
				{page.ui.explainer}
			</p>
			<noscript>
				<p class="font-sans text-xs leading-snug text-warn">
					{page.ui.noscript}
				</p>
			</noscript>
		</div>
	</div>

	<footer class="border-t border-terminal-border px-5 py-4">
		<p class="mb-2 font-mono text-eyebrow uppercase tracking-wider text-ink-5">
			{page.md.inOneSentence}
		</p>
		<p data-summary class="font-sans text-sm leading-relaxed text-ink-7">
			{summarySentence(LIVE_CONFIG, sim)}
		</p>
	</footer>
</section>

<script>
	import {
		formatKnobValue,
		isKnobKey,
		KNOBS,
		type KnobValues,
		LIVE_CONFIG,
		SCENARIOS,
	} from "@/copy-trade/cluster/config";
	import {
		type ClusterSimLocale,
		evaluateSignal,
		signalLine,
		summarySentence,
	} from "@/copy-trade/cluster/simulator";
	import { formattersFor } from "@/copy-trade/locale-format";

	const root = document.querySelector<HTMLElement>("[data-copy-trade-sim]");
	// The SSR-embedded locale bundle: the same catalog-resolved strings the
	// server painted with, so both recomputes can never disagree on a string.
	const payload = root?.querySelector("[data-sim-locale]")?.textContent;

	if (root && payload) {
		const sim = JSON.parse(payload) as ClusterSimLocale;
		const fmt = formattersFor(sim.locale, sim.units);
		const values: KnobValues = { ...LIVE_CONFIG };
		let scenarioId: string = SCENARIOS[0].id;

		const setText = (selector: string, text: string): void => {
			const element = root.querySelector(selector);
			if (element) element.textContent = text;
		};

		const render = (): void => {
			const scenario = SCENARIOS.find((entry) => entry.id === scenarioId) ?? SCENARIOS[0];
			const verdict = evaluateSignal(values, scenario, sim);

			for (const knob of KNOBS) {
				setText(
					`[data-knob-value="${knob.key}"]`,
					formatKnobValue(knob.unit, values[knob.key], fmt),
				);
			}

			root.querySelectorAll<HTMLElement>("[data-scenario]").forEach((button) => {
				button.setAttribute(
					"aria-pressed",
					button.dataset.scenario === scenario.id ? "true" : "false",
				);
			});

			const line = signalLine(scenario, sim);
			setText("[data-signal-lead]", line.lead);
			setText("[data-signal-market]", `“${line.market}”`);
			setText("[data-signal-trail]", line.trail);

			for (const gate of verdict.gates) {
				const row = root.querySelector<HTMLElement>(`[data-gate="${gate.id}"]`);
				if (!row) continue;

				const mark = row.querySelector<HTMLElement>("[data-gate-mark]");
				if (mark) {
					mark.textContent = gate.passed ? "✓" : "✗";
					mark.classList.toggle("text-accent", gate.passed);
					mark.classList.toggle("text-loss", !gate.passed);
				}

				const actual = row.querySelector<HTMLElement>("[data-gate-actual]");
				if (actual) actual.textContent = gate.actual;

				const rule = row.querySelector<HTMLElement>("[data-gate-rule]");
				if (rule) rule.textContent = gate.rule;

				const flag = row.querySelector<HTMLElement>("[data-gate-flag]");
				if (flag) flag.classList.toggle("hidden", !gate.blocker);
			}

			const verdictBox = root.querySelector<HTMLElement>("[data-verdict]");
			if (verdictBox) verdictBox.dataset.action = verdict.action;
			setText("[data-verdict-headline]", verdict.headline);
			setText("[data-verdict-detail]", verdict.detail);
			setText("[data-summary]", summarySentence(values, sim));
		};

		root.addEventListener("input", (event) => {
			const target = event.target;
			if (!(target instanceof HTMLInputElement)) return;
			const key = target.dataset.knob;
			if (!isKnobKey(key)) return;
			values[key] = Number(target.value);
			render();
		});

		root.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;

			const scenarioButton = target.closest<HTMLElement>("[data-scenario]");
			if (scenarioButton?.dataset.scenario !== undefined) {
				scenarioId = scenarioButton.dataset.scenario;
				render();
				return;
			}

			if (target.closest("[data-reset]")) {
				Object.assign(values, LIVE_CONFIG);
				root.querySelectorAll<HTMLInputElement>("[data-knob]").forEach((slider) => {
					const key = slider.dataset.knob;
					if (isKnobKey(key)) slider.value = String(values[key]);
				});
				render();
			}
		});
	}
</script>
