---
import { env } from "cloudflare:workers";
import { buildBeaconAttributes } from "@/lib/analytics/cloudflare-beacon";
import { FEED_CACHE_CONTROL } from "@/lib/http/cached-response";
import { OG_DEFAULT_IMAGE_PATH } from "@/lib/og/paths";
import { SITE_URL } from "@/lib/site/config";
import { buildPageMeta, type OpenGraphType } from "@/lib/site/meta";
import "@/styles/globals.css";

interface Props {
	title?: string;
	description?: string;
	ogType?: OpenGraphType;
	/** Social card image path; defaults to the static brand card. */
	ogImage?: string;
}

const {
	title = "ogsfrompoly — skilled traders on Polymarket",
	description = "We measure who is actually skilled on Polymarket — and we show our work, weekly.",
	ogType = "website",
	ogImage = OG_DEFAULT_IMAGE_PATH,
} = Astro.props;

// Every HTML page inherits the shared cache policy from one place (issue #37):
// content changes at most weekly, so a 1h edge cache is safe and spares the
// Worker a full SSR render on each feed-reader / agent / browser poll.
Astro.response.headers.set("cache-control", FEED_CACHE_CONTROL);

const beacon = buildBeaconAttributes(env.CLOUDFLARE_WEB_ANALYTICS_TOKEN);
const meta = buildPageMeta({
	site: Astro.site ?? SITE_URL,
	path: Astro.url.pathname,
	title,
	description,
	type: ogType,
	image: ogImage,
});

const CONTACT_EMAIL = "hi@ogsfrompoly.com";
const navLinks = [
	{ href: "/statements", label: "Statements" },
	{ href: "/methodology", label: "Methodology" },
	{ href: "/for-dummies", label: "For dummies" },
	{ href: "/rss.xml", label: "RSS" },
	{ href: "/llms.txt", label: "llms.txt" },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={meta.canonical} />
		{Object.entries(meta.og).map(([property, content]) => <meta property={property} content={content} />)}
		{Object.entries(meta.twitter).map(([name, content]) => <meta name={name} content={content} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{beacon && <script is:inline src={beacon.src} defer data-cf-beacon={beacon.dataCfBeacon}></script>}
	</head>
	<body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
		<header class="mx-auto flex max-w-4xl items-center justify-between px-gutter py-6">
			<a
				href="/"
				class="font-mono text-sm font-semibold uppercase tracking-wider text-ink-8 hover:text-accent"
			>
				ogsfrompoly
			</a>
			<nav aria-label="Primary">
				<ul class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 font-mono text-eyebrow uppercase tracking-wider text-ink-6 sm:gap-x-6">
					{
						navLinks.map((link) => (
							<li>
								<a class="hover:text-accent" href={link.href}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<slot />

		<footer class="mx-auto mt-24 max-w-4xl border-t border-ink-3 px-gutter py-8">
			<div class="flex flex-col gap-3 font-mono text-eyebrow uppercase tracking-wider text-ink-5 sm:flex-row sm:items-center sm:justify-between">
				<p>
					Partnership inquiries:
					<a class="text-ink-7 underline-offset-4 hover:text-accent hover:underline" href={`mailto:${CONTACT_EMAIL}`}>
						{CONTACT_EMAIL}
					</a>
				</p>
				<ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
					<li><a class="hover:text-accent" href="/statements">Statements</a></li>
					<li><a class="hover:text-accent" href="/methodology">Methodology</a></li>
					<li><a class="hover:text-accent" href="/for-dummies">For dummies</a></li>
					<li><a class="hover:text-accent" href="/rss.xml">RSS</a></li>
					<li><a class="hover:text-accent" href="/llms.txt">llms.txt</a></li>
					<li><a class="hover:text-accent" href="/sitemap.xml">Sitemap</a></li>
				</ul>
			</div>
		</footer>
	</body>
</html>
