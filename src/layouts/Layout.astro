---
import { env } from "cloudflare:workers";
import { buildBeaconAttributes } from "@/lib/analytics/cloudflare-beacon";
import "@/styles/globals.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = "astro-on-cf", description = "Astro on Cloudflare Workers" } = Astro.props;
const beacon = buildBeaconAttributes(env.CLOUDFLARE_WEB_ANALYTICS_TOKEN);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{beacon && <script is:inline src={beacon.src} defer data-cf-beacon={beacon.dataCfBeacon}></script>}
	</head>
	<body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
		<slot />
	</body>
</html>
